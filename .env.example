# Copy to .env and replace every replace_* value. Do not commit .env.
# Docker Compose uses this file for both its settings and the application.
# Host development uses DATABASE_URL and the loopback service URLs below.

# Required: OpenAI-compatible chat endpoint and model identifier.
CHAT_BASE_URL=https://api.example.com/v1
CHAT_MODEL=replace_with_chat_model
CHAT_API_KEY=replace_with_chat_api_key
# Optional provider-specific setting. Leave empty when unsupported.
CHAT_THINKING=
CHAT_REASONING_EFFORT=
CHAT_REASONING_SPLIT=

# Required for knowledge import and retrieval. The collection expects 1024 dimensions.
EMBED_BASE_URL=https://api.siliconflow.cn/v1
EMBED_MODEL=BAAI/bge-m3
EMBED_API_KEY=replace_with_embedding_api_key
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_API_KEY=replace_with_reranker_api_key

# Compose delivery settings. Use distinct URL-safe passwords (letters, digits, _ and -).
APP_PORT=8080
MYSQL_PASSWORD=replace_with_database_password
MYSQL_ROOT_PASSWORD=replace_with_root_password
MINIO_PASSWORD=replace_with_object_storage_password

# Host development endpoints. Compose injects service DNS addresses and the application DB user.
DATABASE_URL=mysql+asyncmy://root:root@127.0.0.1:3306/mewhelp
TEST_DATABASE_URL=mysql+asyncmy://root:root@127.0.0.1:3306/mewhelp_test
MILVUS_URI=http://127.0.0.1:19530
MILVUS_COLLECTION=mewhelp_knowledge
MCP_LOGISTICS_URL=http://127.0.0.1:8101/mcp
MCP_AFTERSALES_URL=http://127.0.0.1:8102/mcp
CHECKPOINTER_DB_PATH=data/checkpoints.sqlite

# Optional intent and summarization model slots. Empty fields use the chat configuration.
INTENT_MODEL=
INTENT_BASE_URL=
INTENT_API_KEY=
SUMMARY_MODEL=
SUMMARY_BASE_URL=
SUMMARY_API_KEY=

# Optional: all three are required to enable Langfuse. In Docker, use a URL reachable from the app container.
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Optional execution limits. MODEL_CONTEXT_WINDOW=0 uses the built-in lookup.
MODEL_CONTEXT_WINDOW=0
TOKEN_BUDGET=2000
MAX_AGENT_STEPS=6
MAX_USER_INPUT_TOKENS=2000
MAX_OUTPUT_TOKENS=10000
TOOL_RESULT_MAX_TOKENS=3000
EVIDENCE_CONFIDENCE_THRESHOLD=0.30
